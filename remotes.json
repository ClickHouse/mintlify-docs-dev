{
  "$comment": "Stable topology for documentation owned by other repositories. `path` is the source directory and `mount` is its destination below /docs. Production follows each repository's configured default branch; CI supplies an exceptional immutable ref only for a pull-request preview.",
  "remotes": [
    {
      "name": "clickhouse-operator",
      "label": "Kubernetes Operator",
      "repo": "ClickHouse/clickhouse-operator",
      "path": "docs",
      "mount": "products/kubernetes-operator",
      "editPattern": "https://github.com/{repo}/edit/{ref}/{path}"
    },
    {
      "name": "clickhouse-private",
      "label": "ClickHouse Private",
      "repo": "ClickHouse/airgap-docs",
      "path": ".",
      "mount": "products/clickhouse-private",
      "editPattern": "https://github.com/{repo}/edit/{ref}/{path}",
      "assets": [
        {
          "source": "img",
          "mount": "products/clickhouse-private/img"
        }
      ],
      "private": true
    },
    {
      "name": "clickhouse-cpp",
      "label": "C++",
      "repo": "ClickHouse/clickhouse-cpp",
      "ref": "master",
      "path": "docs",
      "mount": "integrations/language-clients/cpp",
      "editPattern": "https://github.com/{repo}/edit/{ref}/{path}"
    },
    {
      "name": "clickhouse-rs",
      "label": "Rust",
      "repo": "ClickHouse/clickhouse-rs",
      "path": "docs",
      "mount": "integrations/language-clients/rust",
      "editPattern": "https://github.com/{repo}/edit/{ref}/{path}"
    },
    {
      "name": "clickhouse-go",
      "label": "Go",
      "repo": "ClickHouse/clickhouse-go",
      "path": "docs",
      "mount": "integrations/language-clients/go",
      "editPattern": "https://github.com/{repo}/edit/{ref}/{path}"
    },
    {
      "name": "clickhouse-c",
      "label": "C",
      "repo": "ClickHouse/clickhouse-c",
      "path": "docs",
      "mount": "integrations/language-clients/c",
      "editPattern": "https://github.com/{repo}/edit/{ref}/{path}"
    },
    {
      "name": "clickhouse-cs",
      "label": ".NET",
      "repo": "ClickHouse/clickhouse-cs",
      "path": "docs",
      "mount": "integrations/language-clients/csharp",
      "editPattern": "https://github.com/{repo}/edit/{ref}/{path}"
    },
    {
      "name": "clickhouse-java",
      "label": "Java",
      "repo": "ClickHouse/clickhouse-java",
      "path": "docs/clickhouse-docs",
      "mount": "integrations/language-clients/java",
      "editPattern": "https://github.com/{repo}/edit/{ref}/{path}"
    },
    {
      "name": "clickhouse-odbc",
      "label": "ODBC",
      "repo": "ClickHouse/clickhouse-odbc",
      "ref": "master",
      "path": "docs",
      "mount": "concepts/features/interfaces/odbc",
      "editPattern": "https://github.com/{repo}/edit/{ref}/{path}"
    },
    {
      "name": "chdb",
      "label": "chDB",
      "repo": "chdb-io/chdb",
      "path": "docs",
      "mount": "chdb",
      "editPattern": "https://github.com/{repo}/edit/{ref}/{path}",
      "assets": [
        {
          "source": "_static",
          "mount": "chdb/_static"
        }
      ]
    },
    {
      "name": "dbt-clickhouse",
      "label": "dbt",
      "repo": "ClickHouse/dbt-clickhouse",
      "path": "docs",
      "mount": "integrations/connectors/data-ingestion/etl-tools/dbt",
      "editPattern": "https://github.com/{repo}/edit/{ref}/{path}"
    }
  ]
}
