      "copy",
      "view",
      {
        "description": "Setup instructions for docs MCP server",
        "href": "/#claude-code",
        "icon": "/images/icons/icon-mcp.svg",
        "title": "Set up docs MCP server"
      }
    ]
  },
  "favicon": "/_site/favicon.svg",
