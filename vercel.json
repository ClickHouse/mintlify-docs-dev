{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "/docs",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/docs/images/:path*",
      "has": [
        {
          "type": "host",
          "value": {
            "suf": ".vercel.app"
          }
        }
      ],
      "destination": "https://clickhouse.com/docs/images/:path*"
    },
    {
      "source": "/docs/img/:path*",
      "has": [
        {
          "type": "host",
          "value": {
            "suf": ".vercel.app"
          }
        }
      ],
      "destination": "https://clickhouse.com/docs/img/:path*"
    }
  ]
}
