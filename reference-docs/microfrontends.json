{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "version": "1",
  "applications": {
    "clickhouse-docs": {
      "development": {
        "local": 4321,
        "fallback": "https://clickhouse.com"
      }
    },
    "clickhouse-reference-docs": {
      "packageName": "clickhouse-reference-docs",
      "development": {
        "local": 4322
      },
      "routing": [
        {
          "group": "reference",
          "paths": [
            "/docs/reference/:path*"
          ]
        }
      ]
    }
  }
}
