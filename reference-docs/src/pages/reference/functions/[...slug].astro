---
import ReferenceBody from "../../../components/ReferenceBody.astro";
import ReferenceLayout from "../../../layouts/ReferenceLayout.astro";
import { categories, categorySlug, functionsForCategory, loadSnapshot } from "../../../lib/snapshot.mjs";
import { renderFunctionBody } from "../../../lib/render-function-body.mjs";

// The unversioned Head tree is produced once during the deployment build.
export const prerender = true;

export function getStaticPaths() {
  try {
    const snapshot = loadSnapshot(process.env.REFERENCE_SNAPSHOT_DIR);
    return categories(snapshot).map((category) => ({
      params: { slug: categorySlug(category) },
      props: { category },
    }));
  } catch {
    // A bucket-less first deployment must not render the checked-in test
    // fixture. It has a static landing page, but no Head content routes.
    return [];
  }
}

const snapshot = loadSnapshot(process.env.REFERENCE_SNAPSHOT_DIR);
const { category } = Astro.props;
const functions = functionsForCategory(snapshot, category);
const body = renderFunctionBody(functions);
---

<ReferenceLayout title={`${category} functions`} version={snapshot.manifest.clickhouseVersion}>
  <ReferenceBody html={body} />
</ReferenceLayout>
