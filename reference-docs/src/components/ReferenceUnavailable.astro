---
const { reason } = Astro.props;
---

<main class="reference-unavailable">
  <p class="eyebrow">Reference documentation</p>
  <h1>Reference content is not available yet</h1>
  <p>{reason}</p>
</main>

<style>
  .reference-unavailable { max-width: 42rem; margin: 8rem auto; padding: 0 1.5rem; color: #3f3f3f; font-family: Inter, system-ui, sans-serif; }
  .reference-unavailable h1 { margin: 0.5rem 0 1rem; color: #171717; font-size: 2rem; }
  .reference-unavailable p { line-height: 1.6; }
  .eyebrow { margin: 0; color: #6b6b6b; font-size: 0.875rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
</style>
