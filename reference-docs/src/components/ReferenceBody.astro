---
const { html } = Astro.props;
---

<main class="reference-body" set:html={html} />

<style is:global>
  .reference-body { max-width: 52rem; margin: 3rem auto; padding: 0 1.5rem 5rem; color: #1c1c1c; font-family: Inter, system-ui, sans-serif; }
  .reference-function { border-bottom: 1px solid #e5e5e5; padding: 2rem 0; }
  .reference-function h2 { font-size: 2rem; margin: 0 0 0.5rem; }
  .reference-function h3 { font-size: 1.1rem; margin: 1.75rem 0 0.5rem; }
  .reference-function pre { overflow-x: auto; padding: 1rem; border-radius: 0.5rem; background: #1c1c1c; color: #f6f6f6; }
  .reference-prose { line-height: 1.65; }
  .introduced { color: #666; font-size: 0.925rem; }
</style>
