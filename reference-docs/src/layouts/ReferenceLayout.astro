---
const { title, version } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title} | ClickHouse Reference</title>
    <meta name="description" content={`ClickHouse ${version} reference documentation`} />
  </head>
  <body>
    <header class="reference-header"><a href="/docs/reference">ClickHouse Docs</a><span>Reference{version ? ` · ${version}` : ""}</span></header>
    <slot />
  </body>
</html>

<style>
  :global(body) { margin: 0; background: #fff; }
  .reference-header { display: flex; gap: 1rem; align-items: center; min-height: 3.5rem; padding: 0 1.5rem; border-bottom: 1px solid #e5e5e5; font-family: Inter, system-ui, sans-serif; }
  .reference-header a { color: inherit; font-weight: 700; text-decoration: none; }
  .reference-header span { color: #666; }
</style>
