{
  "name": "clickhouse-reference-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "VC_MICROFRONTENDS_CONFIG=./microfrontends.json astro dev --port 4322",
    "build": "node bin/fetch-head-snapshot.mjs && REFERENCE_SNAPSHOT_DIR=.cache/reference-head-snapshot VC_MICROFRONTENDS_CONFIG=./microfrontends.json astro build",
    "check": "VC_MICROFRONTENDS_CONFIG=./microfrontends.json astro check",
    "test": "node --test test/**/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/vercel": "^11.0.11",
    "@vercel/microfrontends": "^2.4.0",
    "astro": "~7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "typescript": "^5.8.3"
  }
}
