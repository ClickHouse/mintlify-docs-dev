{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "version": "1",
  "applications": {
    "clickhouse-docs": {
      "development": {
        "local": 4321,
        "fallback": "https://clickhouse.com"
      }
    },
    "clickhouse-docs-i18n": {
      "packageName": "clickhouse-docs",
      "routing": [
        {
          "group": "translations",
          "paths": [
            "/docs/ar/:path*",
            "/docs/es/:path*",
            "/docs/fr/:path*",
            "/docs/ja/:path*",
            "/docs/ko/:path*",
            "/docs/pt-BR/:path*",
            "/docs/ru/:path*",
            "/docs/zh/:path*",
            "/docs/_astro-ar/:path*",
            "/docs/_astro-es/:path*",
            "/docs/_astro-fr/:path*",
            "/docs/_astro-ja/:path*",
            "/docs/_astro-ko/:path*",
            "/docs/_astro-pt-br/:path*",
            "/docs/_astro-ru/:path*",
            "/docs/_astro-zh/:path*",
            "/docs/nav/ar/:path*",
            "/docs/nav/es/:path*",
            "/docs/nav/fr/:path*",
            "/docs/nav/ja/:path*",
            "/docs/nav/ko/:path*",
            "/docs/nav/pt-BR/:path*",
            "/docs/nav/ru/:path*",
            "/docs/nav/zh/:path*"
          ]
        }
      ]
    }
  }
}
