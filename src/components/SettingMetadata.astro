---
interface Props {
  type?: string;
  defaultValue?: string;
  tier?: string;
}

const { type, defaultValue, tier } = Astro.props;
---

<div class="ch-setting-metadata">
  {type && <span class="ch-setting-metadata-label">Type</span>}
  {type && <span class="ch-setting-metadata-value">{type}</span>}
  {defaultValue !== undefined && defaultValue !== "" && <span class="ch-setting-metadata-label">Default</span>}
  {defaultValue !== undefined && defaultValue !== "" && <span class="ch-setting-metadata-value">{defaultValue}</span>}
  {tier && <span class="ch-setting-metadata-label">Tier</span>}
  {tier && <span class="ch-setting-metadata-tier" data-tier={tier.toLowerCase()}>{tier}</span>}
</div>
