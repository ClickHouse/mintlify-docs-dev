---
import ApiPlayground from "./ApiPlayground.astro";
import type { ApiOperationPage as SourceOperation } from "@/lib/openapi";
import ApiBody from "@/components/ui/api-layout/ApiBody.astro";
import type { ApiSecurityScheme } from "@/components/ui/api-layout/auth";
import { ApiCodeRail } from "@/components/ui/api-code-rail";
import type { ApiOperationPage } from "@cloudflare/nimbus-docs/api";

interface Props {
  page: ApiOperationPage;
  authSchemes?: Record<string, ApiSecurityScheme>;
  source: SourceOperation;
}

const { page, authSchemes = {}, source } = Astro.props;
---

<div
  class="ch-api-operation"
  data-api-operation
>
  <div class="ch-api-reference">
    <div class="ch-api-endpoint">
      <div class="ch-api-request-line">
        <span class:list={["ch-api-method", `is-${page.method.toLowerCase()}`]}>{page.method}</span>
        <code class="ch-api-path">{page.path}</code>
        <button
          type="button"
          class="ch-api-copy"
          data-api-copy={`${page.server ?? ""}${page.path}`}
          aria-label="Copy request URL"
        >Copy</button>
      </div>
      <button type="button" class="ch-api-try" data-api-try aria-expanded="false" aria-controls="api-playground-panel" aria-haspopup="dialog">Try it out</button>
    </div>

    <ApiPlayground source={source} />
    <div class="ch-api-reference-body">
    {page.descriptionHtml && <div class="ch-api-description nb-md" set:html={page.descriptionHtml} />}
    <ApiBody page={page} authSchemes={authSchemes} embedded />
    </div>
  </div>

  {(page.samples.length > 0 || page.responses.some((response) => response.example !== undefined)) && (
    <div class="ch-api-console">
      <ApiCodeRail
        responses={page.responses}
        samples={page.samples}
        title={page.title}
        method={page.method}
        coordinate={page.coordinate}
      />
    </div>
  )}
</div>

<script>
  import { mount } from "@cloudflare/nimbus-docs/client";
  mount("[data-api-operation]", container => {
    const panel = container.querySelector<HTMLDialogElement>('#api-playground-panel')!;
    const element = container.querySelector<HTMLElement>('[data-playground-root]')!;
    const specElement = container.querySelector('[data-playground-config]')!;
    const toggle = container.querySelector<HTMLButtonElement>('[data-api-try]')!;
    const selector = panel.querySelector<HTMLButtonElement>('[data-playground-endpoint]')!;
    const config = JSON.parse(specElement.textContent!);
    let renderEndpoint: (() => void) | undefined;
    let initialized = false;
    let root: import("react-dom/client").Root | undefined;
    const controller = new AbortController();
    const options = panel.querySelector<HTMLElement>('#playground-endpoints')!;
    const choices = Array.from(options.querySelectorAll<HTMLButtonElement>('[data-endpoint-value]'));
    const openOptions = () => {
      const bounds = selector.getBoundingClientRect();
      options.style.left = `${bounds.left}px`;
      options.style.top = `${bounds.bottom + 6}px`;
      options.style.width = `${Math.min(560, window.innerWidth - bounds.left - 16)}px`;
      options.style.maxHeight = `${Math.max(120, window.innerHeight - bounds.bottom - 24)}px`;
      options.showPopover();
      (choices.find(choice => choice.dataset.endpointValue === selector.value) ?? choices[0])?.focus();
    };
    selector.addEventListener('click', () => options.matches(':popover-open') ? options.hidePopover() : openOptions(), { signal: controller.signal });
    selector.addEventListener('keydown', event => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') { event.preventDefault(); openOptions(); }
    }, { signal: controller.signal });
    options.addEventListener('toggle', () => selector.setAttribute('aria-expanded', String(options.matches(':popover-open'))), { signal: controller.signal });
    for (const choice of choices) choice.addEventListener('click', () => {
      selector.value = choice.dataset.endpointValue!;
      choices.forEach(item => item.setAttribute('aria-selected', String(item === choice)));
      options.hidePopover(); renderEndpoint?.(); selector.focus();
    }, { signal: controller.signal });
    options.addEventListener('keydown', event => {
      const index = choices.indexOf(document.activeElement as HTMLButtonElement);
      if (event.key === 'Escape') { event.preventDefault(); event.stopPropagation(); options.hidePopover(); selector.focus(); }
      if (['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) {
        event.preventDefault();
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? choices.length - 1 : (index + (event.key === 'ArrowDown' ? 1 : -1) + choices.length) % choices.length;
        choices[next]?.focus();
      }
    }, { signal: controller.signal });
    const status = panel.querySelector<HTMLElement>('[data-playground-status]')!;
    const message = panel.querySelector<HTMLElement>('[data-playground-message]')!;
    const retry = panel.querySelector<HTMLButtonElement>('[data-playground-retry]')!;
    let loading = false;
    const failed = (error: unknown) => {
      initialized = false;
      status.hidden = false;
      retry.hidden = false;
      message.setAttribute('role', 'alert');
      message.textContent = `Unable to load API playground: ${error instanceof Error ? error.message : String(error)}`;
    };
    const initialize = async () => {
      if (initialized || loading) return;
      loading = true;
      status.hidden = false;
      retry.hidden = true;
      message.setAttribute('role', 'status');
      message.textContent = 'Loading API playground…';
      try {
        const [{ createRoot }, { createElement }, { default: Playground }, { flushSync }] = await Promise.all([
          import('react-dom/client'), import('react'), import('./Playground'), import('react-dom'),
        ]);
        if (controller.signal.aborted) return;
        root?.unmount();
        root = createRoot(element, { onUncaughtError: failed });
      renderEndpoint = () => {
        const endpoint = config.endpoints.find((item: { id: string }) => item.id === selector.value);
        if (!endpoint) throw new Error('Unknown playground endpoint');
        const badge = panel.querySelector<HTMLElement>('[data-playground-method]')!;
        panel.querySelector('[data-playground-endpoint-title]')!.textContent = endpoint.title;
        badge.textContent = endpoint.method.toUpperCase();
        badge.className = `pg-method is-${endpoint.method}`;
        flushSync(() => root!.render(createElement(Playground, { key: endpoint.id, config: { ...config, ...endpoint } })));
        panel.querySelector('.ch-playground-modal-body')!.scrollTop = 0;
      };
        initialized = true;
        renderEndpoint();
        status.hidden = initialized;
      } catch (error) {
        failed(error);
      } finally {
        loading = false;
      }
    };
    retry.addEventListener('click', initialize, { signal: controller.signal });
    toggle.addEventListener('click', () => {
      panel.showModal();
      toggle.setAttribute('aria-expanded', 'true');
      void initialize();
    }, { signal: controller.signal });
    panel.querySelector('[data-playground-close]')!.addEventListener('click', () => panel.close(), { signal: controller.signal });
    const outsidePanel = (event: PointerEvent | MouseEvent) => {
      const bounds = panel.getBoundingClientRect();
      return event.target === panel && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom);
    };
    let startedOutside = false;
    panel.addEventListener('pointerdown', event => { startedOutside = outsidePanel(event); }, { signal: controller.signal });
    panel.addEventListener('click', event => {
      if (startedOutside && outsidePanel(event)) panel.close();
      startedOutside = false;
    }, { signal: controller.signal });

    panel.addEventListener('close', () => {
      if (options.matches(':popover-open')) options.hidePopover();
      toggle.setAttribute('aria-expanded', 'false');
      toggle.focus({ preventScroll: true });
    }, { signal: controller.signal });
    return () => { controller.abort(); root?.unmount(); if (panel.open) panel.close(); };
  });
  mount("[data-api-copy]", element => {
    const controller = new AbortController();
    element.addEventListener("click", async () => {
      if (!(element instanceof HTMLElement)) return;
      try {
        await navigator.clipboard.writeText(element.dataset.apiCopy ?? "");
        element.textContent = "Copied";
      } catch {
        element.textContent = "Copy failed";
      }
    }, { signal: controller.signal });
    return () => controller.abort();
  });
</script>

<style>
  .ch-api-operation {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(400px, 48%);
    gap: 2.5rem;
    align-items: start;
    margin-top: 1.25rem;
  }


  .ch-api-reference,
  .ch-api-console {
    min-width: 0;
  }

  .ch-api-endpoint {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--color-muted) 58%, transparent);
  }

  .ch-api-request-line {
    display: flex;
    min-width: 0;
    min-height: 2.75rem;
    flex: 1 1 auto;
    align-items: center;
    gap: 0.65rem;
    padding: 0.45rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--color-border) 80%, transparent);
    border-radius: 0.55rem;
    background: var(--color-background);
  }

  .ch-api-method {
    padding: 0.35rem 0.5rem;
    border-radius: 0.28rem;
    font: 700 0.68rem/1 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .ch-api-method.is-get { color: #16803c; background: #dcfce7; }
  .ch-api-method.is-post { color: #1769aa; background: #dbeafe; }
  .ch-api-method.is-patch,
  .ch-api-method.is-put { color: #9a5800; background: #fef3c7; }
  .ch-api-method.is-delete { color: #b42318; background: #fee4e2; }

  .ch-api-path {
    min-width: 0;
    overflow: auto;
    white-space: nowrap;
    font-size: 0.82rem;
  }

  .ch-api-copy,
  .ch-api-try {
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
  }

  .ch-api-copy {
    margin-left: auto;
    border: 0;
    background: transparent;
    color: var(--color-muted-foreground);
  }
  .ch-api-try {
    display: inline-flex;
    min-height: 2.75rem;
    flex: none;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    padding: 0.45rem 0.9rem;
    border: 1px solid color-mix(in srgb, #45c486 78%, white);
    border-radius: 0.5rem;
    color: #fff;
    background: #39b979;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 18%);
  }

  .ch-api-try:hover { background: #31aa6d; }
  .ch-api-try svg { width: 0.7rem; height: 0.7rem; }

  .ch-api-description {
    margin: 1.15rem 0 1.8rem;
    color: var(--color-foreground);
    line-height: 1.75;
  }

  .ch-api-description :global(h2) {
    margin: 2rem 0 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-foreground);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .ch-api-try { text-decoration: none; }
  .ch-api-console { position: sticky; top: 5rem; margin-top: -10rem; }
  .ch-api-console :global(.nb-cr-layer) { margin: 0; }
  @media (max-width: 79.99rem) {
    .ch-api-operation { grid-template-columns: minmax(0, 1fr); }
    .ch-api-console { position: relative; top: auto; margin-top: 0; }
  }
  @media (max-width: 40rem) {
    .ch-api-request-line { flex-wrap: wrap; }
    .ch-api-path { order: 2; width: 100%; }
  }
</style>
