---
/** Mintlify `<Accordion title defaultOpen icon>`. */
interface Props { title?: string; description?: string; defaultOpen?: boolean; icon?: string }
const { title, description, defaultOpen } = Astro.props;
---

<details class="ch-accordion" open={defaultOpen}>
  <summary>
    <span class="ch-accordion-caret" aria-hidden="true">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="currentColor">
        <path d="M14.0238 4.00002H3.97576C3.33776 4.00002 2.74976 4.34702 2.44276 4.90602C2.13576 5.46502 2.15576 6.14802 2.49776 6.68702L7.52176 14.61C7.84476 15.119 8.39676 15.422 8.99976 15.422C9.60276 15.422 10.1548 15.118 10.4778 14.61L15.5028 6.68602C15.8438 6.14702 15.8648 5.46402 15.5578 4.90502C15.2508 4.34602 14.6628 3.99902 14.0248 3.99902L14.0238 4.00002Z" />
      </svg>
    </span>
    <span class="ch-accordion-copy">
      <span class="ch-accordion-title">{title}</span>
      {description && <span class="ch-accordion-description">{description}</span>}
    </span>
  </summary>
  <div class="ch-accordion-body"><slot /></div>
</details>

<style>
  .ch-accordion {
    margin: 20px 0 12px;
    overflow: hidden;
    border: 1px solid rgb(28 28 28 / 10%);
    border-radius: 4px;
    background: #fff;
  }

  .ch-accordion + .ch-accordion {
    margin-top: 0;
  }

  .ch-accordion summary {
    min-height: 52px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 20px;
    color: var(--nb-heading);
    cursor: pointer;
    list-style: none;
  }

  .ch-accordion summary:hover {
    background: rgb(28 28 28 / 5%);
  }

  .ch-accordion summary::-webkit-details-marker {
    display: none;
  }

  .ch-accordion summary::marker {
    content: "";
  }

  .ch-accordion-caret {
    width: 16px;
    height: 16px;
    display: flex;
    flex: 0 0 16px;
    align-items: center;
    justify-content: center;
    color: var(--nb-muted-foreground);
  }

  .ch-accordion-caret svg {
    width: 12px;
    height: 12px;
    transform: rotate(-90deg);
    transition: transform 200ms ease;
  }

  .ch-accordion[open] .ch-accordion-caret svg {
    transform: rotate(0deg);
  }

  .ch-accordion-copy {
    min-width: 0;
    display: flex;
    flex: 1;
    flex-direction: column;
    text-align: left;
  }

  .ch-accordion-title {
    margin: 0;
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
  }

  .ch-accordion-description {
    color: var(--nb-muted-foreground);
    font-size: 14px;
    line-height: 20px;
  }

  .ch-accordion-body {
    overflow-x: auto;
    padding: 0 20px 14px;
  }

  :global([data-mode="dark"]) .ch-accordion {
    border-color: #3c3c3c;
    background: #242424;
  }

  :global([data-mode="dark"]) .ch-accordion summary:hover {
    background: #2a2a2a;
  }

  @media (prefers-reduced-motion: reduce) {
    .ch-accordion-caret svg {
      transition: none;
    }
  }
</style>
