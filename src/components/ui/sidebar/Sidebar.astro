---
/**
 * Sidebar — recursive navigation tree from a `SidebarItem[]`. Composes
 * SidebarGroup + SidebarLink. Pass `persist` to opt into sessionStorage
 * for open/scroll state (desktop only).
 */
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";
import SidebarGroup from "./SidebarGroup.astro";
import SidebarLink from "./SidebarLink.astro";
import type { SidebarItem } from "@cloudflare/nimbus-docs/types";
import { sidebarHash } from "@cloudflare/nimbus-docs";

interface Props extends HTMLAttributes<"div"> {
  items: SidebarItem[];
  /** Persist open/scroll state to sessionStorage. Desktop sidebar only. */
  persist?: boolean;
  currentLocale?: string;
}

const { items, persist = false, currentLocale, class: className, ...attrs } = Astro.props;
// Bump this when the meaning of persisted disclosure state changes. The
// structural Nimbus hash is intentionally stable across active routes, so it
// cannot invalidate state written before group landing pages became active.
const SIDEBAR_STATE_VERSION = 2;
const hash = `${SIDEBAR_STATE_VERSION}:${sidebarHash(items)}`;
type LazyGroup = Extract<SidebarItem, { type: "group" }> & { _lazyKey?: string };
type IconItem = { icon?: string };
---

<div
  data-nb-sidebar
  data-nb-sidebar-hash={hash}
  data-nb-sidebar-persist={persist ? "" : undefined}
  class={cn(className)}
  {...attrs}
>
  <ul class="top-level flex list-none flex-col gap-0.5 p-0">
    {items.map((item) =>
      item.type === "group" ? (
        <li>
          <SidebarGroup
            label={item.label}
            items={item.children}
            section
            collapsed={item.collapsed}
            badge={item.badge}
            icon={item.icon}
            indexHref={item.indexHref}
            indexIsCurrent={item.indexIsCurrent}
            indexIsExternal={item.indexIsExternal}
            lazyKey={(item as LazyGroup)._lazyKey}
            currentLocale={currentLocale}
          />
        </li>
      ) : item.type === "external" ? (
        <li>
          <SidebarLink label={item.label} href={item.href} badge={item.badge} icon={(item as IconItem).icon} target="_blank" rel="noopener" />
        </li>
      ) : (
        <li>
          <SidebarLink label={item.label} href={item.href} isCurrent={item.isCurrent} badge={item.badge} icon={(item as IconItem).icon} />
        </li>
      ),
    )}
  </ul>
</div>

<script>
  import "./sidebar.client";
  import "./sidebar-lazy.client";
</script>

<style is:global>
  /* Sidebar links carry display utilities, so filtering must win regardless
     of generated stylesheet order. */
  [data-nb-sidebar-hidden] { display: none !important; }

  /* Links and groups are wrapped in list items. Collapse that wrapper too so
     its margins and flex gap cannot leave holes between filtered results. */
  [data-nb-sidebar] li:has(> [data-nb-sidebar-hidden]) { display: none !important; }
</style>
