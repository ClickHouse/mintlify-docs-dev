---
/** Shared disclosure row for sidebar trees whose children are rendered by the caller. */
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { CollapsibleTrigger } from "@/components/ui/collapsible";
import { cn } from "@/lib/cn";

interface Props {
  label: string;
  isOpen: boolean;
  hasActive?: boolean;
  indexHref?: string;
  indexIsCurrent?: boolean;
  deprecated?: boolean;
}

const {
  label,
  isOpen,
  hasActive = false,
  indexHref,
  indexIsCurrent = false,
  deprecated = false,
} = Astro.props;
const rowClass = cn("nb-sidebar-row group/expander", hasActive && "is-active");
const labelClass = cn("break-words", deprecated && "line-through");
---

{indexHref ? (
  <div
    class={cn(rowClass, "p-0", indexIsCurrent && "bg-accent text-foreground font-semibold")}
    data-nb-state={isOpen ? "open" : "closed"}
    data-nb-sidebar-group-label
  >
    <a
      href={indexHref}
      aria-current={indexIsCurrent ? "page" : undefined}
      class="flex min-h-8 min-w-0 flex-1 items-center rounded-l-lg px-3 py-1"
    >
      <span class={labelClass}>{label}</span>
    </a>
    <CollapsibleTrigger
      class="group/expander flex min-h-8 w-auto shrink-0 items-center rounded-r-lg px-1.5 py-1 hover:bg-accent"
      data-nb-state={isOpen ? "open" : "closed"}
      aria-expanded={isOpen ? "true" : "false"}
      aria-label={`Toggle ${label} section`}
    >
      <Icon name="ph:caret-right" class="nb-sidebar-caret" data-nb-caret />
    </CollapsibleTrigger>
  </div>
) : (
  <CollapsibleTrigger
    class={cn(rowClass, "w-full justify-between")}
    data-nb-sidebar-group-label
    data-nb-state={isOpen ? "open" : "closed"}
    aria-expanded={isOpen ? "true" : "false"}
  >
    <span class={labelClass}>{label}</span>
    <Icon name="ph:caret-right" class="nb-sidebar-caret" data-nb-caret />
  </CollapsibleTrigger>
)}
