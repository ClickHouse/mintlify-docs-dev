---
/**
 * TabItem — single tab panel in the `<Tabs>` component.
 *
 * The parent `<Tabs>` reads the rendered metadata and emits the matching
 * trigger into the initial HTML. Each TabItem becomes one panel.
 */
import { cn } from "@/lib/cn";
import { inlinePublicIcon } from "@/lib/build-icon";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  label: string;
  /** Optional image shown before the synthesized tab label. */
  icon?: string;
}

const { label, icon, class: className, ...attrs } = Astro.props;

if (!label) {
  throw new Error("Missing required `label` prop on `<TabItem>` component.");
}

const externalIconAliases: Record<string, string> = {
  "https://clickhouse-docs-assets.s3.us-east-1.amazonaws.com/logo-windsurf.svg": "/images/logo-windsurf.svg",
  "https://clickhouse-docs-assets.s3.us-east-1.amazonaws.com/logo-cursor.png": "/images/logo-cursor.webp",
  "https://clickhouse-docs-assets.s3.us-east-1.amazonaws.com/logo-claudecode-color.svg": "/images/logo-claudecode-color.svg",
  "https://clickhouse-docs-assets.s3.us-east-1.amazonaws.com/logo-claude.svg": "/images/logo-claude.svg",
};
const normalizedIcon = icon ? externalIconAliases[icon] ?? icon : undefined;
const resolvedIcon = normalizedIcon?.startsWith("/") || normalizedIcon?.startsWith("data:")
  ? inlinePublicIcon(normalizedIcon)
  : normalizedIcon;
if (resolvedIcon?.startsWith("http://") || resolvedIcon?.startsWith("https://")) {
  throw new Error(`External tab icon URLs are not supported: ${resolvedIcon}`);
}
---

<div
  role="tabpanel"
  data-nb-tabs-content
  data-nb-tab-label={label}
  data-nb-tab-icon={resolvedIcon}
  class={cn(className)}
  {...attrs}
>
  <slot />
</div>
