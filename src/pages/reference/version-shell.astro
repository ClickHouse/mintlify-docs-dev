---
import DocsLayout from "@/layouts/DocsLayout.astro";
import ArchivedReferenceBody from "@/components/ArchivedReferenceBody.astro";
import ArchivedReferenceNavigation from "@/components/ArchivedReferenceNavigation.astro";
---

<DocsLayout
  title="Archived ClickHouse reference"
  description="Archived ClickHouse reference documentation."
  sidebar={[]}
  headings={[]}
  breadcrumbs={[]}
  prevNext={{}}
  showPageActions={false}
  noindex
  lang="en"
  currentLocale="en"
  generatedFromSystemTables
  persistSidebar
>
  <div slot="page-title" class="ch-document-title">
    <h1 data-reference-archive-title class="text-foreground mb-0 leading-tight [text-wrap:balance]" style="font-size:var(--nb-h1-size);font-weight:var(--nb-h1-weight);letter-spacing:var(--nb-h1-tracking)"><span class="sr-only">Loading archived reference page</span><span aria-hidden="true" class="reference-loading-title"></span></h1>
  </div>
  <ArchivedReferenceNavigation slot="sidebar" />
  <ArchivedReferenceBody />
</DocsLayout>
