---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import { config } from "virtual:nimbus/config";
import { withBase } from "../lib/base";
---

<BaseLayout title={`Page not found · ${config.title}`} description="The page you're looking for doesn't exist.">
  <div class="ch-not-found-shell">
    <Header showSidebar={false} />
    <main id="main-content" tabindex="-1" class="ch-not-found">
      <section class="ch-not-found-card" aria-labelledby="not-found-title">
        <h1 id="not-found-title">Oops! We can&apos;t find this page...</h1>
        <p>The page you&apos;re looking for doesn&apos;t appear to exist or has been moved.</p>

        <div class="ch-not-found-actions">
          <button type="button" class="ch-not-found-back" onclick="history.back()">
            <span aria-hidden="true">←</span> Go back
          </button>
          <a href={withBase("/")}>Go home</a>
        </div>

        <nav class="ch-not-found-links" aria-label="Useful links">
          <a href={withBase("/")}>Documentation</a>
          <a href="https://clickhouse.com/blog" rel="noopener">Our blog</a>
          <a href="https://clickhouse.com/company/events" rel="noopener">Events</a>
        </nav>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .ch-not-found-shell {
    min-height: 100vh;
  }

  .ch-not-found {
    min-height: calc(100vh - 48px);
    display: grid;
    place-items: center;
    padding: 32px;
    background: linear-gradient(105deg, #101010 0%, #171816 48%, #22231f 100%);
  }

  .ch-not-found-card {
    width: min(100%, 810px);
    padding: 34px;
    border: 1px solid #383936;
    border-radius: 10px;
    color: #f4f4f2;
    background: rgb(20 20 20 / 92%);
    box-shadow: 0 1px 0 rgb(255 255 255 / 2%) inset;
  }

  .ch-not-found h1 {
    margin: 0;
    color: #f7f7f5;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.12;
  }

  .ch-not-found p {
    margin: 24px 0 0;
    color: #d0d0cd;
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .ch-not-found-actions {
    display: flex;
    align-items: center;
    gap: 32px;
    margin-top: 24px;
  }

  .ch-not-found-actions a,
  .ch-not-found-links a {
    color: #e4ec54;
    font-weight: 500;
    text-decoration: none;
  }

  .ch-not-found-actions a:hover,
  .ch-not-found-links a:hover {
    color: #fdff75;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ch-not-found-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 16px;
    border: 1px solid #565c00;
    border-radius: 5px;
    color: #f2f2f0;
    background: transparent;
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .ch-not-found-back:hover {
    border-color: #e4ec54;
    background: rgb(228 236 84 / 8%);
  }

  .ch-not-found-links {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    margin-top: 34px;
    padding-top: 34px;
    border-top: 1px solid #2c2d2a;
  }

  @media (max-width: 640px) {
    .ch-not-found { padding: 16px; }
    .ch-not-found-card { padding: 26px 22px; }
    .ch-not-found-actions { gap: 24px; }
  }
</style>
