---
import { getCollection } from "astro:content";
import { getCollectionPageProps } from "@cloudflare/nimbus-docs";
import ChangelogPage from "../../../components/ChangelogPage.astro";
import { readScope } from "../../../lib/scope";

export const prerender = true;
export async function getStaticPaths() {
  const scope = readScope();
  if (!scope.emitEnglish || scope.remotePreview) return [];
  const entries = await getCollection("changelog");
  return entries.map((entry) => {
    const [product, ...slug] = entry.id.split("/");
    if (!product || !slug.length) throw new Error(`Invalid changelog id: ${entry.id}`);
    return {
      params: { product, slug: slug.join("/") },
      props: { entry },
      cacheKey: entry.digest,
    };
  });
}

const { entry, Content } = await getCollectionPageProps<"changelog">(Astro);
---

<ChangelogPage entry={entry} Content={Content} />
