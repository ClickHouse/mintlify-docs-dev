import RemoteDocsPage from "@/components/RemoteDocsPage.astro";

export const prerender = true;
export const getStaticPaths = getCollectionStaticPaths("clickhouse-cpp");

const page = await getCollectionPageProps(Astro, "clickhouse-cpp");
---

