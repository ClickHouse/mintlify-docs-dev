---
/**
 * Locale pages: one Nimbus collection per locale, mounted at /<locale>/...
 * (matching the current /docs/<locale>/... URLs, lowercase). Pages missing from a
 * locale render the English entry with a "not translated yet" notice.
 */
import DocsLayout from "../../layouts/DocsLayout.astro";
import {
  getCollectionStaticPaths,
  getCollectionPageProps,
  getRouteFlags,
  getPrevNext,
  getBreadcrumbs,
  getEditUrl,
  getLastUpdated,
  getTOC,
} from "@cloudflare/nimbus-docs";
import { components } from "../../components";
import { getCollection } from "astro:content";
import { Aside } from "@/components/ui/aside";
import { withBase, stripBase } from "../../lib/base";
import { buildRailFromConfig, sectionsFromConfig } from "../../lib/sidebar-lazy";
import {
  ACTIVE_LOCALES,
  AVAILABLE_LOCALES,
  EMIT_ENGLISH,
  EMIT_LOCALE_FALLBACKS,
  SECTIONS,
  localeCollectionName,
  type LocaleCollectionName,
} from "../../content.config";
import { localeRouteName, notTranslatedNotice } from "../../util/locales";
import { getRemoteEditUrl } from "../../lib/remotes";
import { loadGeneratedNavigation } from "../../lib/sidebar-navigation.server";
import { translatedPageIds } from "../../lib/locale-content.server";

export const prerender = true;

export async function getStaticPaths() {
  const paths: Array<{ params: { locale: string; slug: string | undefined }; props: unknown; cacheKey?: string }> = [];
  for (const sourceLocale of ACTIVE_LOCALES) {
    const collection = localeCollectionName(sourceLocale);
    const locale = localeRouteName(sourceLocale);
    const navigationDigest = loadGeneratedNavigation(sourceLocale).digest;
    const localePaths = (await getCollectionStaticPaths(collection)({} as never)) as Array<{
      params: { slug?: string };
      props: { entry: { id: string; digest?: string } };
      cacheKey?: string;
    }>;
    for (const p of localePaths) {
      const slug = p.params.slug;
      if (
        slug?.startsWith("products/cloud/api-reference/")
        || slug?.startsWith("clickstack/api-reference/")
      ) continue;
      paths.push({
        params: { locale, slug: p.params.slug },
        props: p.props,
        cacheKey: `${p.cacheKey ?? p.props.entry.digest ?? p.props.entry.id}:nav:${navigationDigest}`,
      });
    }
  }

  // A combined artifact emits every fallback from its English shard. A
  // translations-only artifact emits fallbacks from each owning locale shard.
  if (EMIT_LOCALE_FALLBACKS) {
    const english = await getCollection("docs");
    const fallbackLocales = EMIT_ENGLISH ? AVAILABLE_LOCALES : ACTIVE_LOCALES;
    for (const sourceLocale of fallbackLocales) {
      const locale = localeRouteName(sourceLocale);
      const translated = translatedPageIds(sourceLocale, SECTIONS);
      const navigationDigest = loadGeneratedNavigation(sourceLocale).digest;
      for (const entry of english) {
        if (
          translated.has(entry.id)
          || entry.id === "index"
          || entry.id.startsWith("products/cloud/api-reference/")
          || entry.id.startsWith("clickstack/api-reference/")
        ) continue;
        paths.push({
          params: { locale, slug: entry.id },
          props: { entry, fallback: true },
          cacheKey: `fallback:${String(entry.digest ?? entry.id)}:nav:${navigationDigest}`,
        });
      }
    }
  }
  return paths;
}

const { entry, Content, headings } = await getCollectionPageProps<LocaleCollectionName>(Astro);
const fallback = Boolean((Astro.props as { fallback?: boolean }).fallback);
const localeParam = Astro.params.locale as string;
const localeCode = localeCollectionName(localeParam);

const browserPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const currentSlug = stripBase(browserPath);

const { sidebar: sidebarOn, tableOfContents: tocOn } = await getRouteFlags(entry);

// Locale rail: from the locale's generated navigation (labels and /<locale>/
// links), falling back to the English tree when a locale file is absent.
const navItems = loadGeneratedNavigation(localeParam).items;
const sidebar = sidebarOn ? buildRailFromConfig(navItems, browserPath, [localeParam]) : false;
const sections = sectionsFromConfig(navItems, browserPath);
const prevNext = await getPrevNext(browserPath, {
  sidebarTree: sidebar === false ? [] : sidebar,
  overrides: { prev: entry.data.prev, next: entry.data.next },
});
const breadcrumbs = (await getBreadcrumbs(currentSlug, { collection: entry.collection })).map((c) =>
  c.href ? { ...c, href: withBase(c.href) } : c,
);
// A translated page belongs to the main repository. An English fallback can
// originate in a fetched remote, in which case its page actions follow that
// remote's recorded source revision.
const editUrl = fallback ? (getRemoteEditUrl(entry) ?? await getEditUrl(entry)) : await getEditUrl(entry);
const lastUpdated = entry.data.lastUpdated ?? (await getLastUpdated(entry));
const tocConfig = entry.data.tableOfContents;
const tocMax = (entry.data as { toc_max_heading_level?: number }).toc_max_heading_level;
const effectiveTocConfig =
  tocConfig === false ? false : tocMax ? { minHeadingLevel: 2, maxHeadingLevel: Math.max(2, Math.min(6, tocMax)) } : tocConfig;
const toc = tocOn && effectiveTocConfig !== false ? getTOC(headings, effectiveTocConfig) : false;
const layoutMode = entry.data.mode === "custom" ? "custom" : "doc";
const data = entry.data as { title?: string; sidebarTitle?: string };
const pageTitle = data.title ?? data.sidebarTitle ?? entry.id.split("/").pop() ?? entry.id;
const markdownUrl = Astro.site
  ? new URL(withBase(`/${entry.id}.md`), Astro.site).href
  : undefined;
// Untranslated pages point search engines at the English original.
const canonicalUrl = fallback && Astro.site ? new URL(withBase(`/${entry.id}/`), Astro.site).href : undefined;
// hreflang alternates: English plus every active locale (fallback pages exist everywhere).
const HREFLANG: Record<string, string> = { "pt-br": "pt-BR", ar: "ar", es: "es", fr: "fr", ja: "ja", ko: "ko", ru: "ru", zh: "zh" };
const alternates = Astro.site
  ? [
      { hreflang: "en", href: new URL(withBase(`/${entry.id}/`), Astro.site).href },
      { hreflang: "x-default", href: new URL(withBase(`/${entry.id}/`), Astro.site).href },
      ...AVAILABLE_LOCALES.map((l) => ({ hreflang: HREFLANG[localeCollectionName(l)] ?? l, href: new URL(withBase(`/${localeRouteName(l)}/${entry.id}/`), Astro.site!).href })),
    ]
  : [];
const htmlLang = HREFLANG[localeCode] ?? localeParam;
const fallbackNotice = notTranslatedNotice(localeCode);
---

<DocsLayout
  title={pageTitle}
  description={entry.data.description}
  sidebar={sidebar}
  headings={toc}
  breadcrumbs={breadcrumbs}
  prevNext={prevNext}
  mode={layoutMode}
  banner={entry.data.banner}
  head={entry.data.head}
  lang={htmlLang}
  alternates={alternates}
  canonicalUrl={canonicalUrl}
  sections={sections}
  currentLocale={localeParam}
  activeLocales={AVAILABLE_LOCALES}
  searchable={entry.data.searchable}
  noindex={entry.data.noindex}
  markdownUrl={markdownUrl}
  socialImage={entry.data.socialImage}
  lastUpdated={lastUpdated}
  editUrl={editUrl}
  draft={entry.data.draft}
  collection={entry.collection}
  entryId={entry.id}
>
  {fallback && <Aside type="note" label={fallbackNotice.label} title={fallbackNotice.title}>{fallbackNotice.message}</Aside>}
  <Content components={components} />
</DocsLayout>
