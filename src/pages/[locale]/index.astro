---
/**
 * Locale homepages render the authored JSX through generated React islands,
 * preserving the full translated homepage while its source remains in the
 * existing Mintlify tree until cutover.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import ActiveHomepage from "@active-homepage";
import { config } from "virtual:nimbus/config";
import { ACTIVE_LOCALES, AVAILABLE_LOCALES, localeCollectionName } from "../../content.config";
import { localeInfo, localeRouteName } from "../../util/locales";

export const prerender = true;

export function getStaticPaths() {
  return ACTIVE_LOCALES.map((locale) => ({
    params: { locale: localeRouteName(locale) },
    cacheKey: `homepage:${locale}`,
  }));
}

const locale = Astro.params.locale as string;
const localeCode = localeCollectionName(locale);
const info = localeInfo(localeCode);
if (!["ar", "es", "fr", "ja", "ko", "pt-br", "ru", "zh"].includes(localeCode)) {
  throw new Error(`Missing homepage React island for locale ${locale}.`);
}
---

<BaseLayout title={config.title} description={config.description} lang={info.hreflang}>
  <Header showSidebar={false} currentLocale={locale} activeLocales={AVAILABLE_LOCALES} homepage />
  <div class="ch-homepage">
    <ActiveHomepage client:load />
  </div>
</BaseLayout>
